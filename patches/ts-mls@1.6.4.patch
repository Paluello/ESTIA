+
+// ESTIA: RFC 9420 §12.4.3.2 vuole `struct { HPKEPublicKey external_pub; }`,
+// con HPKEPublicKey = opaque<V>: la chiave va preceduta dalla sua lunghezza.
+// ts-mls 1.6.x la scrive nuda, e OpenMLS (come ogni altra implementazione) non
+// legge il GroupInfo. Si scrive col prefisso e si legge in entrambe le forme,
+// perché i punti di rientro già depositati sono nudi (spike S7).
+function estiaScriviExternalPub(chiave) {
+    const n = chiave.length;
+    const prefisso = n < 64 ? new Uint8Array([n]) : new Uint8Array([0x40 | (n >> 8), n & 0xff]);
+    const out = new Uint8Array(prefisso.length + n);
+    out.set(prefisso, 0);
+    out.set(chiave, prefisso.length);
+    return out;
+}
+function estiaLeggiExternalPub(dati) {
+    if (dati.length > 0) {
+        const tipo = dati[0] >> 6;
+        const [lunga, n] = tipo === 0 ? [1, dati[0]] : tipo === 1 && dati.length > 1 ? [2, ((dati[0] & 0x3f) << 8) | dati[1]] : [0, -1];
+        if (lunga > 0 && lunga + n === dati.length)
+            return dati.subarray(lunga);
+    }
+    return dati;
+}
 /** @public */
 export async function createGroupInfoWithExternalPub(state, extensions, cs) {
     const externalKeyPair = await cs.hpke.deriveKeyPair(state.keySchedule.externalSecret);
     const externalPub = await cs.hpke.exportPublicKey(externalKeyPair.publicKey);
-    const gi = await createGroupInfo(state.groupContext, state.confirmationTag, state, [...extensions, { extensionType: "external_pub", extensionData: externalPub }], cs);
+    const gi = await createGroupInfo(state.groupContext, state.confirmationTag, state, [...extensions, { extensionType: "external_pub", extensionData: estiaScriviExternalPub(externalPub) }], cs);
     return gi;
 }
 /** @public */
