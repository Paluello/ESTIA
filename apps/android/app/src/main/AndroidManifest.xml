<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false": il backup automatico riporterebbe su un telefono
  nuovo i file sigillati della cassaforte, che lì non si aprono più perché la
  chiave sta nel Keystore (S6, ADR 0044 §2).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/estrazione_dati"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="ESTIA"
        android:supportsRtl="true"
        android:theme="@style/Tema.Estia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Il QR inquadrato con la fotocamera apre estia://ingresso?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="estia" android:host="ingresso" />
                <!-- e quello d'invito, per chi non è ancora membro, estia://invito?... -->
                <data android:scheme="estia" android:host="invito" />
            </intent-filter>
        </activity>
    </application>
</manifest>
